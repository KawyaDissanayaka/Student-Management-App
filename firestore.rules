rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── AUTHENTICATION & ROLE HELPERS ──────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(roleName) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (getUserDoc().role == roleName || getUserDoc().role == roleName.lower() || getUserDoc().role == roleName.upper());
    }

    function isAdmin() {
      return isAuthenticated() && (
        hasRole('ADMIN') ||
        request.auth.token.email.matches('admin.*') ||
        request.auth.token.email == 'admin@system.com'
      );
    }

    function isLecturer() {
      return isAuthenticated() && (hasRole('LECTURER') || isAdmin());
    }

    function isStudent() {
      return isAuthenticated() && (hasRole('STUDENT') || isAdmin());
    }

    function isFinanceStaff() {
      return isAuthenticated() && (hasRole('FINANCESTAFF') || hasRole('FINANCE_STAFF') || isAdmin());
    }

    function isLibraryStaff() {
      return isAuthenticated() && (hasRole('LIBRARYSTAFF') || hasRole('LIBRARY_STAFF') || isAdmin());
    }

    function isUserEmail(email) {
      return isAuthenticated() && request.auth.token.email.lower() == email.lower();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ─── 1. USERS COLLECTION ────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      // Owner can update permitted fields, but cannot change role/status
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'email'])
      );
      allow delete: if isAdmin();
    }

    // ─── 2. STUDENTS COLLECTION ─────────────────────────────────────────────
    match /students/{studentDocId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      // Student can update only permitted contact fields
      allow update: if isAdmin() || (
        isUserEmail(resource.data.email) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentId', 'course', 'programme', 'batch', 'year', 'semester', 'status', 'gpa', 'credits'])
      );
    }

    // ─── 3. LECTURERS COLLECTION ────────────────────────────────────────────
    match /lecturers/{lecturerDocId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isUserEmail(resource.data.email);
    }

    // ─── 4. ACADEMIC SUBJECTS & TIMETABLE ───────────────────────────────────
    match /subjects/{subjectDocId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /timetable/{timetableId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /enrollments/{enrollmentDocId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── 5. MODULE REGISTRATION SYSTEM ──────────────────────────────────────
    match /moduleRegistrationPeriods/{periodId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /studentModuleRegistrations/{regId} {
      allow read: if isAdmin() || isLecturer() || isUserEmail(resource.data.studentEmail);
      allow create: if isAdmin() || (isStudent() && isUserEmail(request.resource.data.studentEmail));
      allow update: if isAdmin() || (isUserEmail(resource.data.studentEmail) && resource.data.status == 'Pending');
      allow delete: if isAdmin();
    }

    // ─── 6. ATTENDANCE SYSTEM & QR SESSIONS ─────────────────────────────────
    match /attendance/{attendanceDocId} {
      allow read: if isAdmin() || isLecturer() || isUserEmail(resource.data.studentEmail) || request.auth.uid == resource.data.studentDocId;
      allow create, update: if isAdmin() || isLecturer() || isStudent();
      allow delete: if isAdmin();
    }

    match /attendance_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isLecturer();
    }

    // ─── 7. MATERIALS & LECTURE SLIDES ──────────────────────────────────────
    match /materials/{materialDocId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isLecturer();
    }

    // ─── 8. ASSIGNMENTS & SUBMISSIONS ───────────────────────────────────────
    match /assignments/{assignmentDocId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isLecturer();
    }

    match /submissions/{submissionDocId} {
      allow read: if isAdmin() || isLecturer() || isUserEmail(resource.data.studentEmail);
      allow create: if isStudent() && isUserEmail(request.resource.data.studentEmail);
      allow update: if isAdmin() || isLecturer() || isUserEmail(resource.data.studentEmail);
      allow delete: if isAdmin();
    }

    // ─── 9. TASKS & COMPLETION ──────────────────────────────────────────────
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isLecturer();
    }

    match /taskSubmissions/{subId} {
      allow read: if isAdmin() || isLecturer() || isUserEmail(resource.data.studentEmail);
      allow write: if isAuthenticated();
    }

    // ─── 10. EXAMINATIONS, SEATING & RESULTS ────────────────────────────────
    match /exams/{examDocId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /examHalls/{hallDocId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /examRegistrations/{regDocId} {
      allow read: if isAdmin() || isLecturer() || isUserEmail(resource.data.studentEmail);
      allow create, update: if isAdmin() || (isStudent() && isUserEmail(request.resource.data.studentEmail));
      allow delete: if isAdmin();
    }

    match /examSeatings/{seatingDocId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /examAttendance/{attDocId} {
      allow read: if isAdmin() || isLecturer() || isUserEmail(resource.data.studentEmail);
      allow write: if isAdmin() || isLecturer();
    }

    match /examResults/{resultDocId} {
      allow read: if isAdmin() || isLecturer() || (isUserEmail(resource.data.studentEmail) && resource.data.status == 'Published');
      allow create: if isAdmin() || isLecturer();
      // Lecturers can update draft/submitted, but only Admin can publish
      allow update: if isAdmin() || (
        isLecturer() &&
        request.resource.data.status != 'Published'
      );
      allow delete: if isAdmin();
    }

    match /results/{resultDocId} {
      allow read: if isAdmin() || isLecturer() || isUserEmail(resource.data.studentEmail);
      allow write: if isAdmin() || isLecturer();
    }

    // ─── 11. FINANCE, FEES & ONLINE PAYMENTS ────────────────────────────────
    match /fee_structures/{structureDocId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isFinanceStaff();
    }

    match /payments/{paymentDocId} {
      allow read: if isAdmin() || isFinanceStaff() || isUserEmail(resource.data.studentEmail);
      allow create: if isAuthenticated();
      // Student cannot mark payment as completed or refund; only Admin/FinanceStaff can verify
      allow update: if isAdmin() || isFinanceStaff() || (
        isUserEmail(resource.data.studentEmail) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'amount', 'verifiedAt', 'refundedAt'])
      );
      allow delete: if isAdmin() || isFinanceStaff();
    }

    // ─── 12. TRANSPORT MANAGEMENT ───────────────────────────────────────────
    match /transportRoutes/{routeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /transportBuses/{busId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /transportSchedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /studentTransportPreferences/{prefId} {
      allow read: if isAdmin() || isUserEmail(resource.data.studentEmail);
      allow write: if isAdmin() || (isAuthenticated() && isUserEmail(request.resource.data.studentEmail));
    }

    // ─── 13. CAMPUS FACILITIES & MAP ────────────────────────────────────────
    match /facilities/{facilityId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── 14. LIBRARY & BOOK LOANS ───────────────────────────────────────────
    match /libraryBooks/{bookId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isLibraryStaff();
    }

    match /libraryBorrowings/{borrowingId} {
      allow read: if isAdmin() || isLibraryStaff() || isUserEmail(resource.data.studentEmail);
      allow write: if isAdmin() || isLibraryStaff();
    }

    // ─── 15. ANNOUNCEMENTS & NOTIFICATIONS ──────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isLecturer();
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || isUserEmail(resource.data.recipientId) || isUserEmail(resource.data.userEmail);
      allow create: if isAuthenticated();
      allow update: if isAdmin() || isUserEmail(resource.data.recipientId) || isUserEmail(resource.data.userEmail);
      allow delete: if isAdmin() || isUserEmail(resource.data.recipientId);
    }

    // ─── 16. AUDIT TRAIL & SYSTEM CONFIG ────────────────────────────────────
    match /profileAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit log
    }

    match /settings/{settingDocId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
